# Copy to repo root as .env.aws (never commit). Neon (ap-southeast-1) + Cloudflare Pages assumed.

API_DOMAIN=api.yourdomain.org

POSTGRES_DB=neondb
POSTGRES_USER=your_neon_user
POSTGRES_PASSWORD=your_neon_password
POSTGRES_HOST=ep-xxxx.ap-southeast-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

DJANGO_SECRET_KEY=replace-with-50-plus-random-characters
DJANGO_ALLOWED_HOSTS=api.yourdomain.org,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.org,https://www.yourdomain.org
CSRF_TRUSTED_ORIGINS=https://yourdomain.org,https://www.yourdomain.org,https://api.yourdomain.org

GUNICORN_WORKERS=2